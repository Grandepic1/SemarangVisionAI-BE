APP_NAME=Semarang Vision AI

# Database engine: "postgresql" or "mysql"
DB_TYPE=postgresql
DB_HOST=localhost
# Optional; defaults to 5432 for postgresql, 3306 for mysql
DB_PORT=
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=semarangvision

SCHEDULER_ENABLED=true
SCRAPE_TIMEZONE=Asia/Jakarta

TOM_API_KEY=

# --- Flood detection ---
# Path to the trained YOLO flood model (relative paths resolve against the project root).
FLOOD_MODEL_PATH=flood_yolo11s_run/best.pt
# Inference image size for flood detection.
FLOOD_IMGSZ=416
# Per-camera frame-grab timeout in milliseconds.
FLOOD_GRAB_TIMEOUT_MS=10000
# Concurrent camera streams analyzed per request.
FLOOD_MAX_WORKERS=8