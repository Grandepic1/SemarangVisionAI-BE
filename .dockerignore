# Version control
.git
.gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Caches & tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Secrets & local files
.env
*.log

# Training data / tooling not needed at runtime
datasets/
notebooks/
scripts/
yolo11s.pt

# Training runs — keep ONLY the trained flood model the image bakes in
runs/*
!runs/detect
runs/detect/*
!runs/detect/flood_yolo11s_run
runs/detect/flood_yolo11s_run/*
!runs/detect/flood_yolo11s_run/best.pt
