# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env

# YOLO training artifacts (ultralytics) + local datasets
runs/
datasets/
# Downloaded ultralytics base weights (yolo11n.pt etc.)
*.pt

# Local logs
*.log

# The trained flood model IS tracked (required by the Docker build on any
# device) — un-ignore just that one file inside the otherwise-ignored runs/.
!runs/
runs/*
!runs/detect
runs/detect/*
!runs/detect/flood_yolo11s_run
runs/detect/flood_yolo11s_run/*
!runs/detect/flood_yolo11s_run/best.pt
